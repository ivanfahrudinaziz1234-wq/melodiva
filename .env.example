# Copy to .env.local (local dev) and set the same values in Vercel > Project > Settings > Environment Variables.
# Every service is optional: when a value is missing the site runs in "demo mode" for that feature.

# Public URL of the site, without trailing slash (used for SEO, sitemap, email links).
NEXT_PUBLIC_SITE_URL=https://melodiva.example

# Band WhatsApp number in international format without "+" (e.g. 6285875050845).
NEXT_PUBLIC_WHATSAPP_NUMBER=6285875050845

# Supabase > Project Settings > API. Required for the contact form, analytics, and /admin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. NEVER expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Melodiva Music <hello@melodiva.example>"
# Where client replies land (the band's normal inbox).
EMAIL_REPLY_TO=hello@melodiva.example
# Receives the "Pesan baru dari ..." alert for every new inquiry.
ADMIN_NOTIFICATION_EMAIL=

# Cloudflare Turnstile (anti-bot). Widget is hidden when these are empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Random secret for privacy-friendly visitor hashing. Generate with: openssl rand -base64 32
ANALYTICS_HASH_SALT=

# Upstash Redis for rate limiting (optional; falls back to the Postgres rate_limits table).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
